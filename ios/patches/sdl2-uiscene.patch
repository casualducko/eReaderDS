+/* UIScene life cycle (required by apps built with the iOS 27 SDK, and what lets
+ * a window follow a folding or resizing display): the scene delegate named in
+ * the Info.plist's UIApplicationSceneManifest. */
+@interface SDLUIKitSceneDelegate : UIResponder<UIWindowSceneDelegate>
+@property (nonatomic, strong) UIWindow *window;
+@end
+
+/* YES when the Info.plist has a scene manifest. */
+BOOL SDL_UIKit_UsesScenes(void);
+/* The window scene to put a window in, waiting (running the run loop) for it
+ * to connect; nil when the app doesn't use scenes. */
+UIWindowScene *SDL_UIKit_WaitForWindowScene(void);
+
 @interface SDLUIKitDelegate : NSObject<UIApplicationDelegate>
 
 + (id)sharedAppDelegate;
 + (NSString *)getAppDelegateClassName;
 
 - (void)hideLaunchScreen;
