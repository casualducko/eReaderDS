 @end
 
+static UIWindowScene *sdl_window_scene;
+
+BOOL SDL_UIKit_UsesScenes(void)
+{
+    return [[NSBundle mainBundle] objectForInfoDictionaryKey:@"UIApplicationSceneManifest"] != nil;
+}
+
+UIWindowScene *SDL_UIKit_WaitForWindowScene(void)
+{
+    CFAbsoluteTime end = CFAbsoluteTimeGetCurrent() + 10.0;
+    if (!SDL_UIKit_UsesScenes()) {
+        return nil;
+    }
+    while (!sdl_window_scene && CFAbsoluteTimeGetCurrent() < end) {
+        for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+            if ([scene isKindOfClass:[UIWindowScene class]]) {
+                sdl_window_scene = (UIWindowScene *)scene;
+                break;
+            }
+        }
+        if (!sdl_window_scene) {
+            CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, true);
+        }
+    }
+    return sdl_window_scene;
+}
+
+@implementation SDLUIKitSceneDelegate
+
+@synthesize window;
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if ([scene isKindOfClass:[UIWindowScene class]]) {
+        sdl_window_scene = (UIWindowScene *)scene;
+    }
+    for (UIOpenURLContext *context in connectionOptions.URLContexts) {
+        [[SDLUIKitDelegate sharedAppDelegate] sendDropFileForURL:context.URL];
+    }
+}
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == sdl_window_scene) {
+        sdl_window_scene = nil;
+    }
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+    for (UIOpenURLContext *context in URLContexts) {
+        [[SDLUIKitDelegate sharedAppDelegate] sendDropFileForURL:context.URL];
+    }
+}
+
+@end
+
 @implementation SDLUIKitDelegate {
